%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 284 95
%%HiResBoundingBox: 0 0 283.465 94.488
%%Title: F - Modern Simple Embroidery Motif
%%Creator: OpenAI
%%LanguageLevel: 2
%%Pages: 1
%%EndComments

% Vector embroidery artwork, black thread.
% Artwork size: 75 mm wide x 25 mm high.
% Coordinates are in PostScript points (1 pt = 1/72 inch).
1 setlinejoin
1 setlinecap
0 setgray

% Left and right horizontal accent lines (approx. 1.8 mm thick)
5.0 setlinewidth
newpath
8 47.2 moveto
93 47.2 lineto
stroke
newpath
190.5 47.2 moveto
275.5 47.2 lineto
stroke

% Central interlocking angular emblem.
% Use broad, clean satin-friendly outlines with generous corners.
7.0 setlinewidth
newpath
104 65
lineto 132 65
lineto 153 47.2
lineto 132 29.5
lineto 118 29.5
lineto 139 47.2
lineto 118 65
stroke

newpath
179.5 29.5
lineto 151.5 29.5
lineto 130.5 47.2
lineto 151.5 65
lineto 165.5 65
lineto 144.5 47.2
lineto 165.5 29.5
stroke

% Small inner joining accents to make the interlock read clearly.
3.5 setlinewidth
newpath
132 65 moveto
144.5 47.2 lineto
stroke
newpath
151.5 29.5 moveto
139 47.2 lineto
stroke

showpage
%%EOF
